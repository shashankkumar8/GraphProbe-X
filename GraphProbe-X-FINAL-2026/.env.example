# GraphProbe-X FINAL 2026 — never paste real secrets into chat or commit them.
# Primary OpenAI-compatible provider (OpenRouter recommended for the project).
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-4o-mini

# Optional fallback provider/model.
LLM_FALLBACK_MODEL=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=

# TigerGraph Cloud / Savanna
TG_HOST=
TG_USER=tigergraph
TG_PASS=
TG_GRAPH=GraphProbeX
TG_SECRET=

# Development only: set LLM_PROVIDER=mock and/or GPX_EMBED=hash for offline smoke tests.
# LLM_PROVIDER=mock
# GPX_EMBED=hash
